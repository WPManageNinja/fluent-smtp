includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 0
    paths:
        - app/
        - includes/
    bootstrapFiles:
        - includes/libs/google-api-client/build/vendor/autoload.php
    scanFiles:
        - app/Services/DB/wpfluent.php
    excludePaths:
        - includes/libs/
        - app/Services/DB/
    scanDirectories:
        - includes/
        - database/
        - app/Services/DB/
    treatPhpDocTypesAsCertain: false
